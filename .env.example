# Database — matches docker-compose.yml defaults.
# DATABASE_URL is the APP runtime URL (least-privilege mark_api login).
# Migrations run as the mark_app owner via alembic.ini / OWNER_DATABASE_URL.
# If you change mark_api's password, change it in BOTH places at once:
# here (DATABASE_URL) and in scripts/init-db.sql + migration 004.
DATABASE_URL=postgresql+psycopg2://mark_api:mark_api_password@localhost:5432/agent_mark
DATABASE_URL_ASYNC=postgresql+psycopg2://mark_api:mark_api_password@localhost:5432/agent_mark
# Direct psycopg URL for scripts (app role)
DATABASE_DSN=postgresql://mark_api:mark_api_password@localhost:5432/agent_mark
# Owner URL for migrations only (never use for the app runtime)
OWNER_DATABASE_URL=postgresql+psycopg2://mark_app:mark_app_password@localhost:5432/agent_mark
POSTGRES_USER=mark_app
POSTGRES_PASSWORD=mark_app_password
POSTGRES_DB=agent_mark

# N2 performance budgets and fixture sizes
N2_SEED_STUDENTS=1200
N2_SEED_CLASSES=30
N2_SEED_TEACHERS=30
N2_PERF_READ_P95_MS=1000
N2_PERF_WRITE_P95_MS=2000

# API binding — per Node Architecture Section 3: localhost + LAN only, never public internet
API_HOST=127.0.0.1
# For LAN binding, set to 0.0.0.0 on the school LAN. The app refuses to bind to a public interface
# unless ALLOW_PUBLIC_BIND=true (which must never be set in production).
API_PORT=8000
ALLOW_PUBLIC_BIND=false
